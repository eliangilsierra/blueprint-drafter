<mxfile host="plano"><diagram name="Internet Banking"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Internet Banking" style="rounded=1;arcSize=10;absoluteArcSize=1;dashed=1;fillColor=#F7F8FA;strokeColor=#A9B2BF;fontColor=#3B4552;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=IBM Plex Sans;container=0;" vertex="1" parent="1"><mxGeometry x="159" y="341" width="516.6666666666666" height="624" as="geometry"/></mxCell><mxCell id="customer" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#4A5363&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4A5363&quot;&gt;A customer of the bank, with personal bank accounts&lt;/font&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF0FB;strokeColor=#4152B0;fontColor=#17202B;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="303" y="58" width="224" height="116" as="geometry"/></mxCell><mxCell id="mailSystem" value="&lt;b&gt;E-Mail System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#535C69&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#535C69&quot;&gt;The internal Microsoft Exchange system&lt;/font&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7584;fontColor=#1F2630;fontFamily=IBM Plex Sans;dashed=1;" vertex="1" parent="1"><mxGeometry x="67" y="1146" width="208" height="94" as="geometry"/></mxCell><mxCell id="mainframe" value="&lt;b&gt;Mainframe Banking System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#535C69&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#535C69&quot;&gt;Stores all of the core banking information&lt;/font&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7584;fontColor=#1F2630;fontFamily=IBM Plex Sans;dashed=1;" vertex="1" parent="1"><mxGeometry x="319" y="1146" width="208" height="94" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;Single-Page App&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#4A5667&quot;&gt;[Web App: JavaScript, Angular]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4A5667&quot;&gt;Provides all the Internet banking functionality&lt;/font&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2763B0;fontColor=#14202E;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="221.7" y="517" width="208" height="94" as="geometry"/></mxCell><mxCell id="webApp" value="&lt;b&gt;Web Application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#4A5667&quot;&gt;[Container: Java, Spring MVC]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#4A5667&quot;&gt;Delivers the static content and the SPA&lt;/font&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EAF2FC;strokeColor=#2763B0;fontColor=#14202E;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="177" y="381" width="228" height="78" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#45584F&quot;&gt;[Database: SQL Database]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#45584F&quot;&gt;Stores user registration information&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;size=7;whiteSpace=wrap;html=1;fillColor=#E6F4EF;strokeColor=#1C7A5F;fontColor=#13241E;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="433.9" y="855" width="212" height="92" as="geometry"/></mxCell><mxCell id="mobile" value="&lt;b&gt;Mobile App&l