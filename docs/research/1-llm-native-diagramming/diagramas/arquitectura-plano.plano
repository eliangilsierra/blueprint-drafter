plano 1 type=architecture dir=TB title="Plano — arquitectura propuesta (núcleo local-first + adaptadores finos)"
group agents zone "Agentes y humanos"
group adapters boundary "Adaptadores (sin lógica de dominio)"
group core boundary "Núcleo determinista (librería TypeScript)"
group outputs zone "Salidas"
node agent actor "Agente de código" in=agents desc="Claude Code, Codex, Gemini CLI, OpenHands"
node human person "Desarrollador / revisor" in=agents
node ci service "CI (GitHub Actions…)" in=agents desc="plano check en cada PR"
node skill module "Skill (SKILL.md)" in=adapters desc="Cuándo y cómo usar la herramienta"
node cli service "CLI plano" in=adapters desc="Interfaz universal"
node mcp service "Servidor MCP (stdio)" in=adapters desc="6 herramientas tipadas"
node viewer webapp "Vista previa / revisión" in=adapters desc="Diff visual y aprobación"
node ops component "Operaciones" in=core desc="+ ~ - atómicas, ids estables"
node model component "Modelo semántico" in=core desc="Tipos, grupos, restricciones"
node rules component "Reglas por tipo" in=core desc="C4, flujo, secuencia"
node text component "Medición tipográfica" in=core desc="Métricas reales de la fuente"
node layout component "Layout" in=core desc="ELK Layered + motores específicos"
node stable component "Edición estable" in=core desc="Reparación local + enrutado"
node validator component "Validador" in=core desc="Semántico + geométrico"
node render component "Renderizador SVG" in=core desc="Temas por rol semántico"
node exporters component "Exportadores" in=core desc="PNG, Mermaid, Excalidraw, draw.io"
node src storage "Fuente .plano" in=outputs tech=Git desc="Texto canónico, diffs legibles"
node lock storage "Layout lock" in=outputs tech=JSON desc="Posiciones para estabilidad"
node files storage "Artefactos" in=outputs desc="SVG, PNG, .drawio, .excalidraw"
edge agent>skill "descubre"
edge agent>cli "ejecuta"
edge agent>mcp "llama"
edge human>viewer "revisa"
edge ci>cli "valida"
edge skill>cli "enseña"
edge cli>ops "aplica"
edge mcp>ops "aplica"
edge viewer>ops "edita"
edge ops>model "transforma"
edge model>rules "comprueba"
edge model>text "mide"
edge text>layout "tamaños"
edge layout>validator "geometría"
edge stable>validator "geometría"
edge model>stable "cambios"
edge validator>render "aprobado"
edge render>exporters "SVG"
edge ops>src "escribe"
edge stable>lock "lee/escribe"
edge exporters>files "genera"
